<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jeeagile.process.mapper.AgileProcessOrderMapper">

    <!-- 查询用户有权限的工单ID列表（基于权限关联表，各维度取并集） -->
    <select id="selectOrderIdsByScope" resultType="java.lang.String">
        SELECT DISTINCT order_id FROM agile_process_order_scope
        <trim prefix="WHERE" prefixOverrides="OR">
            <if test="userId != null and userId != ''">
                OR (scope_type = 'user' AND scope_id = #{userId})
            </if>
            <if test="deptId != null and deptId != ''">
                OR (scope_type = 'dept' AND scope_id = #{deptId})
            </if>
            <if test="roleIds != null and roleIds.size() > 0">
                OR (scope_type = 'role' AND scope_id IN
                <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
                    #{roleId}
                </foreach>
                )
            </if>
            <if test="postIds != null and postIds.size() > 0">
                OR (scope_type = 'post' AND scope_id IN
                <foreach collection="postIds" item="postId" open="(" separator="," close=")">
                    #{postId}
                </foreach>
                )
            </if>
        </trim>
    </select>

</mapper>
